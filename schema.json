{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vijayndran.github.io/erp-roles/schema.json",
  "title": "ERP Roles taxonomy",
  "type": "object",
  "required": ["meta", "ladders", "roles"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "meta": {
      "type": "object",
      "required": ["title", "description", "platforms", "streams", "tiers", "compCurrency", "compNote"],
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "source": { "type": "string" },
        "license": { "type": "string" },
        "asOf": { "type": "string", "description": "Month the comp bands were last calibrated, e.g. 2026-10" },
        "platforms": { "type": "object", "additionalProperties": { "type": "string" }, "minProperties": 1 },
        "streams": { "type": "object", "additionalProperties": { "type": "string" }, "minProperties": 1 },
        "tiers": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "compCurrency": { "type": "string" },
        "compNote": { "type": "string" }
      }
    },
    "ladders": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" },
        "minItems": 2
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "positionTitle", "platforms", "stream", "tier", "summary", "requiredSkills", "preferredSkills", "compMin", "compMax", "aliases"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "positionTitle": { "type": "string", "minLength": 1 },
          "platforms": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "One or more platform keys from meta.platforms." },
          "stream": { "type": "string", "description": "A stream key from meta.streams." },
          "tier": { "type": "string" },
          "summary": { "type": "string", "minLength": 1, "description": "One-line JD skeleton: what the role does." },
          "requiredSkills": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "preferredSkills": { "type": "array", "items": { "type": "string" } },
          "compMin": { "type": "integer", "minimum": 0 },
          "compMax": { "type": "integer", "minimum": 0 },
          "aliases": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
